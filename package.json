{
  "name": "netpulse",
  "version": "1.0.3",
  "description": "NetPulse — пульс вашей сети. Десктопное приложение сетевой диагностики и мониторинга.",
  "main": "out/main/index.js",
  "author": "impuLseUZ",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "pack:win": "electron-vite build && electron-builder --win --config electron-builder.yml",
    "pack:linux": "electron-vite build && electron-builder --linux --config electron-builder.yml",
    "pack:mac": "electron-vite build && electron-builder --mac --config electron-builder.yml",
    "publish:win": "electron-vite build && electron-builder --win --publish always --config electron-builder.yml",
    "release": "electron-vite build && electron-builder --win --publish always --config electron-builder.yml"
  },
  "dependencies": {
    "@cloudflare/speedtest": "^1.10.1",
    "@types/ssh2": "^1.15.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.2.1",
    "i18next": "^23.11.5",
    "lucide-react": "^0.400.0",
    "p-limit": "^5.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^14.1.2",
    "recharts": "^3.8.1",
    "ssh2": "^1.17.0",
    "whois": "^2.16.1",
    "xterm": "^5.3.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5",
    "vite": "^5.3.1"
  },
  "allowScripts": {
    "electron@31.7.7": true,
    "esbuild@0.21.5": true,
    "cpu-features@0.0.10": true,
    "ssh2@1.17.0": true
  }
}
